# API key for the OpenAI-compatible chat endpoint used by both examples.
# Default endpoint: http://127.0.0.1:1234/v1 (LM Studio, llama.cpp, etc.)
API_KEY=

# Chat model identifier passed to the OpenAI-compatible client.
# Default: google/gemma-4-e4b
CHAT_MODEL=google/gemma-4-e4b

# Base URL of the OpenAI-compatible chat endpoint.
# Default: http://127.0.0.1:1234/v1 (LM Studio, llama.cpp, etc.)
CHAT_BASE_URL=http://127.0.0.1:1234/v1

# Permission policy for filesystem tools. One of: allow, deny, prompt.
# Default: prompt
PERMISSION_POLICY=prompt

# Comma-separated list of allowed filesystem roots (first is the primary
# write root). Default: ./
SANDBOX_ROOTS=./

# ----- RAG -----

# Model variant name (fastembed 5.x FromStr format; was a HuggingFace model code before 0.10.0)
FASTEMBED_MODEL=BGESmallENV15

# Paths to the SQLite + turbovec RAG artifacts. Both must stay in sync;
# delete both to recover from "out of sync" errors.
RAG_DB_PATH=./rag_data/rag.db
RAG_INDEX_PATH=./rag_data/rag.tvim

# ----- LangSmith / OpenTelemetry (examples/langsmith_react.rs only) -----

# Required: LangSmith API key (ls_...).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default
# Full OTLP/HTTP traces URL, including the signal path. Used as-is by the
# OTel SDK — no path is appended. For LangSmith cloud this is the default
# (the /v1/traces suffix is required). For a local OTel collector, use
# http://localhost:4318/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
OTEL_SERVICE_NAME=agent_rs
RUST_LOG=info

# Reserved for future use. Currently the OTel layer is installed without a
# parallel tracing_subscriber::fmt layer — see src/observability/mod.rs.
# LANGSMITH_OTEL_CONSOLE=1
